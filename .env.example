# Kanal 1 — API anahtarları.
# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur. .env asla GitHub'a gitmez (.gitignore).
# Ortamda (ör. bulut ortam ayarları) tanımlı bir değişken varsa .env'deki değerden önce o kullanılır.

# Anthropic — araştırma, senaryo, kalite kontrol. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# fal.ai — Seedance 2.5 video. https://fal.ai/dashboard/keys
FAL_KEY=

# Google Gemini — Nano Banana Pro anahtar kareler. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ElevenLabs — seslendirme ve ses efekti. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Pexels — referans fotoğraf (ücretsiz). https://www.pexels.com/api/
PEXELS_API_KEY=

# --- İsteğe bağlı ---
# Google Görseller araması (varsayılan kapalı, config.yaml > image_search.serpapi_enabled)
SERPAPI_API_KEY=
# Telegram bildirimleri (config.yaml > notify.telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
